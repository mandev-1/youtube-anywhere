{
  "manifest_version": 3,
  "name": "YouTube Mini – vlevo dole",
  "short_name": "YouTube Mini",
  "version": "1.0.0",
  "description": "Přepne aktuálně přehrávané video z YouTube, Kicku nebo Instagramu do Picture-in-Picture nad všechny stránky.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://kick.com/*",
    "https://www.kick.com/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": ["instagram-fix.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://kick.com/*",
        "https://www.kick.com/*",
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": ["autopip.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube Mini: zapnout / vypnout plovoucí video",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Zapnout nebo vypnout YouTube Mini"
    },
    "next_video": {
      "suggested_key": {
        "default": "Alt+Shift+Down",
        "mac": "Alt+Shift+Down"
      },
      "description": "Přejít na další reel / video"
    },
    "prev_video": {
      "suggested_key": {
        "default": "Alt+Shift+Up",
        "mac": "Alt+Shift+Up"
      },
      "description": "Přejít na předchozí reel / video"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
